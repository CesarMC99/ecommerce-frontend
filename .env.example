# ─── API GraphQL ─────────────────────────────────────────────
# NAVEGADOR. En local: la URL del backend. En producción: "/graphql"
# (mismo dominio de la tienda; Vercel lo reenvía al backend con BACKEND_URL)
NEXT_PUBLIC_GRAPHQL_API_URL=http://localhost:3000/graphql
# SERVIDOR (Server Components). Solo en producción: URL completa del backend
# GRAPHQL_API_URL=https://tu-backend.onrender.com/graphql
# Proxy /graphql → backend. Solo en producción (en local NO se define)
# BACKEND_URL=https://tu-backend.onrender.com

# ─── Servicios externos (claves PÚBLICAS: pueden estar en el navegador) ──
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=tu-cloud-name
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxx
